{
  "manifest_version": 3,
  "name": "a11y Simulator",
  "version": "1.0",
  "description": "",
  "permissions": ["activeTab", "tabs"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/Content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_popup": "extension-menu.html"
  }
}