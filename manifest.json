{
  "manifest_version": 3,
  "name": "a11y Simulator",
  "version": "1.0",
  "description": "",
  "permissions": ["activeTab", "tabs"],
  "icons": {
    "16": "./img/A11Y-sim-icon-16.png",
    "32": "./img/A11Y-sim-icon-32.png",
    "48": "./img/A11Y-sim-icon-64.png", 
    "128": "./img/A11Y-sim-icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/Content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_popup": "extension-menu.html"
  }
}